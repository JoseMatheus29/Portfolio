---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ExperienceTabs from '../components/ExperienceTabs';
import ProjectGrid, { type ProjetoCard } from '../components/ProjectGrid';
import { experiencias } from '../data/experiencia';
import { comBase, curriculo, foto, site } from '../data/site';

const colecao = await getCollection('projetos');
const projetos: ProjetoCard[] = colecao
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map(({ id, data }) => ({
    id,
    nome: data.nome,
    origem: data.origem,
    resumo: data.resumo,
    stackCurta: data.stackCurta,
    tecnologias: data.tecnologias,
    largura: data.largura,
    destaque: data.destaque,
    funcionalidades: data.funcionalidades,
    capturas: data.capturas.map((captura) => ({ ...captura, src: comBase(captura.src) })),
    href: comBase(`projetos/${id}/`),
  }));
---

<Layout titulo={`${site.nome} · ${site.cargo}`}>
  <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-base font-semibold">
    <a href={comBase()} class="py-3 text-xl font-extrabold">{site.marca}</a>
    <nav aria-label="Principal" class="flex flex-wrap gap-x-5 gap-y-1">
      <a href="#projetos" class="py-3 hover:text-marca">Projetos</a>
      <a href="#experiencia" class="py-3 hover:text-marca">Experiência</a>
      <a href="#contato" class="py-3 hover:text-marca">Contato</a>
    </nav>
  </header>

  <main id="conteudo" class="flex flex-col gap-3.5">
    <div class="grid grid-cols-12 gap-3.5">
      <section class="col-span-12 flex min-w-0 flex-col justify-between gap-8 rounded-bloco bg-bloco p-[clamp(24px,4vw,48px)] md:col-span-8">
        <div class="flex flex-col gap-4">
          <p class="font-semibold text-marca">{site.nome} · {site.cidade}</p>
          <h1 class="text-[clamp(40px,6vw,80px)] font-extrabold leading-none tracking-[-0.035em]">Construo apps e as APIs por trás deles.</h1>
        </div>
        <div class="flex flex-wrap gap-2.5 font-bold">
          <a href="#projetos" class="rounded-xl bg-marca px-[22px] py-[13px] text-white transition-colors hover:bg-tinta">Ver projetos</a>
          <a href={curriculo} download class="rounded-xl border border-borda px-[22px] py-3 transition-colors hover:bg-fundo">Baixar currículo</a>
        </div>
      </section>
      <div class="col-span-12 aspect-square min-w-0 overflow-hidden rounded-bloco bg-bloco md:col-span-4 md:aspect-auto md:min-h-[280px]">
        <img
          src={foto}
          alt="José Matheus sorrindo, de camisa azul, em fundo branco"
          width="1000"
          height="1000"
          fetchpriority="high"
          class="block size-full object-cover object-top"
        />
      </div>
    </div>

    <ProjectGrid client:load projetos={projetos} />

    <section id="experiencia" aria-labelledby="titulo-experiencia" class="mt-7 flex min-w-0 scroll-mt-4 flex-col gap-6 rounded-bloco bg-bloco p-[clamp(22px,4vw,48px)]">
      <h2 id="titulo-experiencia" class="text-[clamp(30px,3.6vw,48px)] font-extrabold leading-[1.05] tracking-[-0.025em]">Experiência</h2>
      <ExperienceTabs client:load experiencias={experiencias} />
    </section>

    <div class="grid grid-cols-12 gap-3.5">
      <section aria-labelledby="titulo-formacao" class="col-span-12 flex min-w-0 flex-col gap-3 rounded-bloco bg-bloco p-7 md:col-span-4">
        <h2 id="titulo-formacao" class="text-[22px] font-bold">Formação</h2>
        <p class="text-base"><strong>Sistemas e Mídias Digitais</strong><br /><span class="text-suave">Bacharelado, UFC, 2022 a 2026</span></p>
        <p class="text-base"><strong>Informática</strong><br /><span class="text-suave">Técnico integrado, IFCE, 2018 a 2022</span></p>
      </section>
      <footer id="contato" class="col-span-12 flex min-w-0 scroll-mt-4 flex-col justify-between gap-5 rounded-bloco bg-marca p-[clamp(24px,3vw,36px)] text-white md:col-span-8">
        <h2 class="text-[clamp(30px,4vw,52px)] font-extrabold leading-[1.02] tracking-[-0.03em]">Vamos conversar?</h2>
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-bold">
          <a href={`mailto:${site.email}`} class="[overflow-wrap:anywhere] underline underline-offset-4">{site.email}</a>
          <span class="flex gap-5">
            <a href={site.github} target="_blank" rel="noopener" class="py-3 underline underline-offset-4">GitHub</a>
            <a href={site.linkedin} target="_blank" rel="noopener" class="py-3 underline underline-offset-4">LinkedIn</a>
          </span>
        </div>
      </footer>
    </div>
  </main>
</Layout>
